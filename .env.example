# OpenAI API Key - lấy tại https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here

# OpenAI Model config (optional - defaults below)
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3

# Groq API (free, nhanh) - lấy tại https://console.groq.com
# GROQ_API_KEY=your_groq_key_here

# Hugging Face Token - DISABLED (sử dụng OpenAI thay thế)
# HUGGINGFACE_TOKEN=your_hugging_face_key_here

# Supabase - lấy tại https://supabase.com → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Auto-Learning APIs (để AI tự crawl ảnh fashion)
# Unsplash: https://unsplash.com/developers → New Application
# UNSPLASH_ACCESS_KEY=your_unsplash_key_here
# Pexels: https://www.pexels.com/api/ → Get API Key (free)
# PEXELS_API_KEY=your_pexels_key_here